CREWAI_TRACING_ENABLED=false

# GitHub API access. ai/.env can override this for AI-only local setups.
GITHUB_TOKEN=

# Generate a unique secret with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
REPOMIND_JWT_SECRET=
REPOMIND_ACCESS_TOKEN_MINUTES=60

# Needed only when registering analyses on a deployed/local registry.
REPOMIND_BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
REPOMIND_CONTRACT_ADDRESS=
REPOMIND_BLOCKCHAIN_PRIVATE_KEY=

# Needed only when running backend/create_admin.py.
REPOMIND_ADMIN_USERNAME=admin
REPOMIND_ADMIN_EMAIL=admin@repomind.local
REPOMIND_ADMIN_PASSWORD=
